# BluePax CMS with docker compose, see deploy/README.md. Copy to .env next to
# docker-compose.yml and fill in every value marked "required". Never commit the filled-in file.

# Image. Pin a version for production (e.g. ghcr.io/bluepax/bluepax-cms:1.0.0) and change it to
# upgrade. Until 1.0.0 only `beta` (the newest beta) and `edge` (every merge into dev) exist.
BLUEPAX_IMAGE=ghcr.io/bluepax/bluepax-cms:beta

# Required: public URL of the CMS, as admins and frontends reach it (no trailing slash). Media
# URLs in the Delivery API start with it and the CSRF check compares against it. For a local
# try without a gateway: http://localhost:3001
ORIGIN=https://cms.example.com

# Required: database password; hex keeps it URL-safe (openssl rand -hex 24).
POSTGRES_PASSWORD=
# Required: signs sessions and short-lived tokens, at least 32 characters (openssl rand -base64 48).
APP_SECRET=
# Required: encrypts stored credentials, 32 bytes as base64 (openssl rand -base64 32). Keep a
# copy outside the server: a restored backup needs the same key.
ENCRYPTION_KEY=
# Required: one-time token the setup wizard asks for, at least 16 characters (openssl rand -hex 16).
BLUEPAX_INSTALL_TOKEN=

# Where the CMS listens on the host. Keep 127.0.0.1 and put a gateway with HTTPS in front.
BLUEPAX_BIND=127.0.0.1
BLUEPAX_PORT=3001

# Real visitor IP (login and API rate limits, audit log). Only the gateway reaches the CMS, so
# its header can be trusted: Caddy / OpenResty set X-Forwarded-For (XFF_DEPTH=1 trusts exactly
# one proxy), Cloudflare Tunnel sets CF-Connecting-IP. Empty: the connection's address.
ADDRESS_HEADER=
XFF_DEPTH=1

# Largest request body. Must exceed the largest upload limit (媒体 → 存储设置, video 200 MB by
# default); other requests are held to 10 MB. Gateways have their own limit (deploy/gateway/).
BODY_SIZE_LIMIT=256M

# Roles of this container: web (admin and APIs), worker (background jobs such as the daily
# backup) or both. A separate worker container is described in deploy/README.md.
BLUEPAX_ROLES=web,worker

# Optional: initialise an empty instance unattended from a config file (chapter 2). Uncomment
# the ./config mount in docker-compose.yml and name the file as the container sees it.
# BLUEPAX_CONFIG_FILE=/config/corporate.yaml
