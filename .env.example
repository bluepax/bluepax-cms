# Local development, matches deploy/dev/compose.yaml. Copy to .env (read by apps/cms).
# Never use these values outside your machine.
DATABASE_URL=postgres://bluepax:bluepax@127.0.0.1:5432/bluepax
# Signs sessions and short-lived tokens: at least 32 random characters (openssl rand -base64 48).
APP_SECRET=dev-only-secret-change-me-0123456789abcdef
# Encrypts stored credentials such as TOTP secrets: 32 bytes as base64 (openssl rand -base64 32).
ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0wMTIzNDU2Nzg=
# One-time token the setup wizard asks for (at least 16 characters, e.g. openssl rand -hex 16).
BLUEPAX_INSTALL_TOKEN=dev-only-install-token
# Optional: initialise an empty instance unattended from a config file (chapter 2).
# BLUEPAX_CONFIG_FILE=../../examples/config/corporate.yaml
# Roles started by this process: web, worker or both.
BLUEPAX_ROLES=web,worker
# Local media storage root; the container uses /data/uploads (the uploads volume). The path is
# relative to apps/cms, so this keeps development uploads in the git-ignored /data folder.
BLUEPAX_UPLOADS_DIR=../../data/uploads
# Backups before migrations (docs/adr/0015). Unset, `vite dev` migrates without a backup; set it
# (and install the PostgreSQL client for pg_dump) to try backups locally. The image uses
# /data/backups, the backups volume.
# BLUEPAX_BACKUPS_DIR=../../data/backups
# Production only (adapter-node): the CMS's public URL, e.g. https://cms.example.com. Media URLs
# in the Delivery API start with it (docs/adr/0012); `vite dev` uses the request's own origin.
# A production build refuses to start without it. Docker deployments: see deploy/.env.example.
# ORIGIN=https://cms.example.com
# Development only: fictional admin created by `pnpm --filter @bluepax/cms seed:dev`.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=dev-only-password-change-me
