# Minimal BluePax frontend. Copy to .env (git-ignored) and fill in.
# The token is a secret: it is only read on the server and never sent to browsers.

# Public URL of the BluePax CMS (not of this frontend). Server-side calls need no CORS.
BLUEPAX_CMS_URL=http://localhost:5173

# Delivery Token with the delivery:read scope, issued in the CMS under "接入与 API"
# (shown once). Rotate it there: issue a new one, switch, then revoke the old one.
BLUEPAX_DELIVERY_TOKEN=

# Optional: the CMS's preview secret ("接入与 API"). When set, /preview checks the link's
# signature and expiry before asking the CMS, which checks it again either way.
BLUEPAX_PREVIEW_SECRET=

# Production (adapter-node): this frontend's public URL, e.g. https://www.example.com
# ORIGIN=
