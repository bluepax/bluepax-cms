{
  "name": "@bluepax/cms",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@bluepax/core": "workspace:*",
    "@bluepax/db": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "vite": "^8.3.8"
  }
}
