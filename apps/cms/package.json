{
  "name": "@bluepax/cms",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "seed:dev": "node --env-file=../../.env scripts/seed-dev.ts"
  },
  "dependencies": {
    "@bluepax/cms-blocks": "workspace:*",
    "@bluepax/core": "workspace:*",
    "@bluepax/db": "workspace:*",
    "@bluepax/presets": "workspace:*",
    "@bluepax/storage": "workspace:*",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "~1.77.0",
    "@node-rs/argon2": "^2.2.2",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "bits-ui": "^2.20.0",
    "cn": "^0.5.2",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.2.0",
    "jsdom": "^30.1.3",
    "shadcn-svelte": "^1.8.1",
    "sharp": "^0.35.5",
    "tailwind-variants": "^3.3.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/plugin-m-function-matcher": "^2.4.3",
    "@inlang/plugin-message-format": "^4.6.0",
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/jsdom": "^30.0.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
