{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist",
    // In the workspace @bluepax/cms-blocks exports its TypeScript sources; compile against its
    // built declarations instead, so only this package's files are emitted.
    "paths": {
      "@bluepax/cms-blocks": ["../cms-blocks/dist/index.d.ts"],
      "@bluepax/cms-blocks/*": ["../cms-blocks/dist/*.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
